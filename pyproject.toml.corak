[project]
name = "corak"
version = "0.1.0"
description = "Combinational Regularity Analysis with Kleene-Valued Conditions"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "GPL-3.0" }
keywords = [
    "configurational comparative methods",
    "CORA", "INUS causation", "Kleene logic",
    "missing data", "causal inference",
]
authors = [
    { name = "CORAK Contributors" }
]
dependencies = [
    "numpy>=1.24",
    "pandas>=2.0",
    "cora @ git+https://github.com/PoliUniLu/cora.git",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.4",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 88
target-version = "py310"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "UP", "N", "B", "SIM", "RUF"]
ignore = ["N802", "N803", "N806"]  # allow uppercase in math-heavy code

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["ANN", "S"]
"examples/*" = ["ANN", "T201"]  # allow print() in examples

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts   = "-v --tb=short"

[tool.hatch.build.targets.wheel]
packages = ["corak"]
